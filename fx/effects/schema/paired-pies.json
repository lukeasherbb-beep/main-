{
 "id": "paired-pies",
 "name": "Two proportions",
 "family": "chart",
 "purpose": "Compare two animated percentages",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ffbf40"
  },
  "secondary": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#d74747"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "data": {
   "type": "series_list",
   "mode": "value",
   "required": true,
   "minItems": 2,
   "maxItems": 2,
   "needLabel": true,
   "label": {
    "maxLength": 40
   },
   "number": {
    "min": 0,
    "max": 100
   },
   "note": "each entry is {label, value}; replaces the sample data entirely",
   "default": [
    {
     "label": "JOBS AUTOMATED",
     "value": 30
    },
    {
     "label": "WORKERS REPLACED",
     "value": 44
    }
   ]
  }
 }
}
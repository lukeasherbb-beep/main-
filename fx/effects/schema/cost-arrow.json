{
 "id": "cost-arrow",
 "name": "Price and direction",
 "family": "profile",
 "purpose": "Link a price, replaceable object and directional arrow",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": "PER KWH"
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 1,
   "required": true,
   "default": [
    "assets/money.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#a6ed32"
  },
  "number": {
   "type": "number",
   "min": 0,
   "max": 1000000000000000,
   "required": true,
   "default": 0.5
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": "$"
  },
  "decimals": {
   "type": "number",
   "min": 0,
   "max": 6,
   "integer": true,
   "default": 2
  }
 }
}
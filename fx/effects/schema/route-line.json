{
 "id": "route-line",
 "name": "Trace a route",
 "family": "map",
 "purpose": "Explain movement between editable locations",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#dd3838"
  },
  "secondary": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#d95765"
  },
  "mapBounds": {
   "type": "bounds",
   "required": true,
   "format": "[west, south, east, north] in degrees",
   "default": [
    -128,
    24,
    -65,
    51
   ]
  },
  "points": {
   "type": "point_list",
   "required": true,
   "format": "[longitude, latitude] pairs, longitude first",
   "minItems": 1,
   "maxItems": 8,
   "default": [
    [
     -120,
     34
    ],
    [
     -95,
     42
    ],
    [
     -73,
     39
    ]
   ]
  },
  "pointLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 40
   },
   "sameLengthAs": "points",
   "required": true,
   "default": [
    "",
    "",
    ""
   ]
  }
 }
}
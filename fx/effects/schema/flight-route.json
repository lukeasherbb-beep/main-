{
 "id": "flight-route",
 "name": "Moving route marker",
 "family": "map",
 "purpose": "Animate an editable vehicle or subject along a path",
 "duration": {
  "default": 6,
  "min": 3,
  "max": 18
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#cb2633"
  },
  "secondary": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#d95765"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "mapBounds": {
   "type": "bounds",
   "required": true,
   "format": "[west, south, east, north] in degrees",
   "default": [
    38,
    23,
    66,
    42
   ]
  },
  "points": {
   "type": "point_list",
   "required": true,
   "format": "[longitude, latitude] pairs, longitude first",
   "minItems": 1,
   "maxItems": 8,
   "default": [
    [
     51.4,
     35.7
    ],
    [
     54,
     26
    ]
   ]
  },
  "pointLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 40
   },
   "sameLengthAs": "points",
   "required": true,
   "default": [
    "City A",
    ""
   ]
  }
 }
}
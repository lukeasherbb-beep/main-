{
 "id": "torn-profile",
 "name": "Paper-cut profile",
 "family": "profile",
 "purpose": "Reveal a subject with a torn-paper name treatment",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": "SAMPLE NAME"
  },
  "subtitle": {
   "type": "text",
   "maxLength": 160,
   "default": ""
  },
  "label": {
   "type": "text",
   "maxLength": 80,
   "default": "The Antagonist"
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 1,
   "required": true,
   "default": [
    "assets/original-person-a.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#9c2028"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "enter": {
   "type": "number",
   "min": 0.03,
   "max": 0.45,
   "default": 0.22
  }
 }
}
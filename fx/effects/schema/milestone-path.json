{
 "id": "milestone-path",
 "name": "Milestone journey",
 "family": "diagram",
 "purpose": "Travel along a curved path of labelled milestones",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": ""
  },
  "labels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 6,
   "pad": 6,
   "item": {
    "maxLength": 100
   },
   "default": [
    "First Step",
    "Growing",
    "Accelerating",
    "Success",
    "Next Stage",
    "Complete"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ffee63"
  },
  "secondary": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#d95765"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "motion": {
   "type": "number",
   "min": 0,
   "max": 2,
   "default": 1
  }
 }
}
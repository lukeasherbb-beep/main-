{
 "id": "chart-overlay",
 "name": "Chart over footage",
 "family": "chart",
 "purpose": "Place a two-series chart over an editable background",
 "duration": {
  "default": 6,
  "min": 3,
  "max": 18
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": "Data Comparison Over Time"
  },
  "backgroundImage": {
   "type": "image",
   "required": true,
   "default": "assets/original-highland.png"
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#337bb9"
  },
  "secondary": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#d04b57"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": ""
  },
  "suffix": {
   "type": "text",
   "maxLength": 12,
   "default": ""
  },
  "data": {
   "type": "series_list",
   "mode": "values",
   "required": true,
   "minItems": 2,
   "maxItems": 2,
   "needLabel": true,
   "label": {
    "maxLength": 40
   },
   "number": {
    "min": 0,
    "max": 1000000000
   },
   "values": {
    "minItems": 2,
    "maxItems": 24
   },
   "note": "each series is {label, values:[numbers]}; replaces the sample data entirely",
   "default": [
    {
     "label": "A",
     "values": [
      90,
      75,
      62,
      45,
      32,
      18,
      5
     ]
    },
    {
     "label": "B",
     "values": [
      5,
      18,
      31,
      45,
      62,
      76,
      90
     ]
    }
   ]
  },
  "axisLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 24
   },
   "default": [
    "2020",
    "2021",
    "2022",
    "2023",
    "2024",
    "2025",
    "2026"
   ]
  }
 }
}
{
 "id": "picture-area-chart",
 "name": "Picture-filled area chart",
 "family": "chart",
 "purpose": "Reveal a data area filled with an editable relevant image",
 "duration": {
  "default": 10,
  "min": 5,
  "max": 30
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": "Big increase in sample prices"
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 1,
   "required": true,
   "default": [
    "assets/original-highland.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#00cc79"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#161616"
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": ""
  },
  "suffix": {
   "type": "text",
   "maxLength": 12,
   "default": ""
  },
  "data": {
   "type": "series_list",
   "mode": "values",
   "required": true,
   "minItems": 1,
   "maxItems": 1,
   "needLabel": true,
   "label": {
    "maxLength": 40
   },
   "number": {
    "min": 0,
    "max": 1000000000
   },
   "values": {
    "minItems": 2,
    "maxItems": 24
   },
   "note": "each series is {label, values:[numbers]}; replaces the sample data entirely",
   "default": [
    {
     "label": "Sample prices",
     "values": [
      18,
      40,
      34,
      49,
      41,
      74
     ]
    }
   ]
  },
  "axisLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 24
   },
   "default": [
    "2003",
    "",
    "",
    "",
    "",
    "2026"
   ]
  }
 }
}
{
 "id": "money-counter",
 "name": "Money and meaning",
 "family": "title",
 "purpose": "Count to an amount then explain its significance",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "subtitle": {
   "type": "text",
   "maxLength": 160,
   "default": "PER DAY ON AVERAGE"
  },
  "backgroundImage": {
   "type": "image",
   "required": true,
   "default": "assets/original-highland.png"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "number": {
   "type": "number",
   "min": 0,
   "max": 1000000000000000,
   "required": true,
   "default": 5.5
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": "$"
  },
  "suffix": {
   "type": "text",
   "maxLength": 12,
   "default": ""
  },
  "decimals": {
   "type": "number",
   "min": 0,
   "max": 6,
   "integer": true,
   "default": 2
  }
 }
}
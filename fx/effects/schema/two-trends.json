{
 "id": "two-trends",
 "name": "Two animated trends",
 "family": "chart",
 "purpose": "Compare two labelled lines over time",
 "duration": {
  "default": 6,
  "min": 3,
  "max": 18
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": ""
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#24a6c3"
  },
  "secondary": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#c56470"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": ""
  },
  "suffix": {
   "type": "text",
   "maxLength": 12,
   "default": ""
  },
  "data": {
   "type": "series_list",
   "mode": "values",
   "required": true,
   "minItems": 2,
   "maxItems": 2,
   "needLabel": true,
   "label": {
    "maxLength": 40
   },
   "number": {
    "min": 0,
    "max": 1000000000
   },
   "values": {
    "minItems": 2,
    "maxItems": 24
   },
   "note": "each series is {label, values:[numbers]}; replaces the sample data entirely",
   "default": [
    {
     "label": "USA",
     "values": [
      8,
      9,
      18,
      16,
      28,
      35,
      33,
      43,
      50,
      47,
      61,
      64,
      72,
      79
     ]
    },
    {
     "label": "CHINA",
     "values": [
      2,
      3,
      5,
      4,
      12,
      9,
      16,
      21,
      15,
      25,
      22,
      33,
      30,
      37
     ]
    }
   ]
  },
  "axisLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 24
   },
   "default": [
    "2021",
    "2022",
    "2023",
    "2024",
    "2025"
   ]
  }
 }
}
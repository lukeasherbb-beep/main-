{
 "id": "image-to-crowd",
 "name": "Image to population",
 "family": "diagram",
 "purpose": "Explain an image through a connected crowd of symbols",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "images": {
   "type": "image_list",
   "maxItems": 6,
   "slots": 1,
   "required": true,
   "default": [
    "assets/original-coastal-city.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#aaaaaa"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "number": {
   "type": "number",
   "min": 0,
   "max": 1000000000000000,
   "required": true,
   "default": 40
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": ""
  },
  "suffix": {
   "type": "text",
   "maxLength": 12,
   "default": ""
  },
  "fit": {
   "type": "enum",
   "values": [
    "cover",
    "contain"
   ],
   "default": "cover"
  }
 }
}
{
 "id": "brand-stat",
 "name": "Brand and statistic",
 "family": "profile",
 "purpose": "Pair a brand image with a numeric headline",
 "duration": {
  "default": 6,
  "min": 3,
  "max": 18
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 1,
   "required": true,
   "default": [
    "assets/mark.png"
   ]
  },
  "backgroundImage": {
   "type": "image",
   "required": true,
   "default": "assets/original-highland.png"
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ff940b"
  },
  "number": {
   "type": "number",
   "min": 0,
   "max": 1000000000000000,
   "required": true,
   "default": 42
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": "$"
  },
  "suffix": {
   "type": "text",
   "maxLength": 24,
   "default": " MILLION IN SALES"
  }
 }
}
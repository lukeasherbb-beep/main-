{
 "id": "single-trend",
 "name": "Single growth trend",
 "family": "chart",
 "purpose": "Draw a time series progressively across axes",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 0,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": ""
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#eeeeee"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#202b3c"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "prefix": {
   "type": "text",
   "maxLength": 8,
   "default": ""
  },
  "suffix": {
   "type": "text",
   "maxLength": 12,
   "default": ""
  },
  "data": {
   "type": "series_list",
   "mode": "values",
   "required": true,
   "minItems": 1,
   "maxItems": 1,
   "needLabel": true,
   "label": {
    "maxLength": 40
   },
   "number": {
    "min": 0,
    "max": 1000000000
   },
   "values": {
    "minItems": 2,
    "maxItems": 24
   },
   "note": "each series is {label, values:[numbers]}; replaces the sample data entirely",
   "default": [
    {
     "label": "$ Billions",
     "values": [
      80,
      200,
      330,
      410,
      550,
      640
     ]
    }
   ]
  },
  "axisLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 24
   },
   "default": [
    "2000",
    "2002",
    "2004",
    "2006",
    "2008",
    "2010"
   ]
  }
 }
}
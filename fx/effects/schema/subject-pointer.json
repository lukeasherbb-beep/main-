{
 "id": "subject-pointer",
 "name": "Subject callout",
 "family": "profile",
 "purpose": "Point from a label to a replaceable foreground subject",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": "AN INNOCENT"
  },
  "subtitle": {
   "type": "text",
   "maxLength": 160,
   "default": "JOB TITLE HERE"
  },
  "label": {
   "type": "text",
   "maxLength": 80,
   "default": ""
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 1,
   "required": true,
   "default": [
    "assets/original-person-a.png"
   ]
  },
  "backgroundImage": {
   "type": "image",
   "required": true,
   "default": "assets/original-highland.png"
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ffe738"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "enter": {
   "type": "number",
   "min": 0.03,
   "max": 0.45,
   "default": 0.22
  }
 }
}
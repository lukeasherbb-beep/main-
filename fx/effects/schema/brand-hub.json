{
 "id": "brand-hub",
 "name": "Connected brand hub",
 "family": "diagram",
 "purpose": "Connect a central brand to supporting images",
 "duration": {
  "default": 6,
  "min": 3,
  "max": 18
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 5,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "labels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 4,
   "pad": 4,
   "item": {
    "maxLength": 100
   },
   "default": [
    "",
    "",
    "",
    ""
   ]
  },
  "images": {
   "type": "image_list",
   "maxItems": 6,
   "slots": 5,
   "required": true,
   "default": [
    "assets/mark.png",
    "assets/original-highland.png",
    "assets/original-highland.png",
    "assets/original-highland.png",
    "assets/original-highland.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ffe738"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "enter": {
   "type": "number",
   "min": 0.03,
   "max": 0.45,
   "default": 0.22
  }
 }
}
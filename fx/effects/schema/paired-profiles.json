{
 "id": "paired-profiles",
 "name": "People compared",
 "family": "profile",
 "purpose": "Introduce two people with editable portraits and names",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 2,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "labels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 2,
   "pad": 2,
   "item": {
    "maxLength": 100
   },
   "default": [
    "SAMPLE PERSON A",
    "SAMPLE PERSON B"
   ]
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 2,
   "required": true,
   "default": [
    "assets/original-person-a.png",
    "assets/original-person-b.png"
   ]
  },
  "backgroundImage": {
   "type": "image",
   "required": true,
   "default": ""
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "fit": {
   "type": "enum",
   "values": [
    "cover",
    "contain"
   ],
   "default": "cover"
  }
 }
}
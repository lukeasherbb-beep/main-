{
 "id": "map-to-city",
 "name": "Country to city zoom",
 "family": "map",
 "purpose": "Move from broad geography into a specific map image and label",
 "duration": {
  "default": 6,
  "min": 3,
  "max": 18
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 1,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "title": {
   "type": "text",
   "maxLength": 120,
   "default": "Harbor district"
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 1,
   "required": true,
   "default": [
    "assets/original-coastal-city.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ffe738"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "foreground": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#f3f1e9"
  },
  "enter": {
   "type": "number",
   "min": 0.03,
   "max": 0.45,
   "default": 0.22
  },
  "motion": {
   "type": "number",
   "min": 0,
   "max": 2,
   "default": 1
  },
  "country": {
   "type": "country",
   "required": true,
   "default": "United Arab Emirates"
  },
  "mapBounds": {
   "type": "bounds",
   "required": true,
   "format": "[west, south, east, north] in degrees",
   "default": [
    44,
    20,
    63,
    30
   ]
  },
  "pointLabels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 8,
   "item": {
    "maxLength": 40
   },
   "sameLengthAs": "points",
   "default": [
    "Harbor district"
   ]
  },
  "focusX": {
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0.5
  },
  "focusY": {
   "type": "number",
   "min": 0,
   "max": 1,
   "default": 0.45
  }
 }
}
{
 "id": "age-comparison",
 "name": "Then and now",
 "family": "profile",
 "purpose": "Explain a change between two replaceable subjects",
 "duration": {
  "default": 4,
  "min": 2,
  "max": 12
 },
 "fps": {
  "default": 30,
  "min": 10,
  "max": 60
 },
 "imageSlots": 2,
 "notes": "Image paths are relative to the folder holding the overrides file. Fewer images than the layout has: they repeat. Keys marked required have no usable sample figure and must be supplied. Text may use \"|\" as a line break where the sample does.",
 "keys": {
  "labels": {
   "type": "text_list",
   "minItems": 1,
   "maxItems": 2,
   "pad": 2,
   "item": {
    "maxLength": 100
   },
   "default": [
    "",
    ""
   ]
  },
  "images": {
   "type": "image_list",
   "maxItems": 3,
   "slots": 2,
   "required": true,
   "default": [
    "assets/original-person-a.png",
    "assets/original-person-b.png"
   ]
  },
  "accent": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#ffea37"
  },
  "background": {
   "type": "color",
   "format": "#rrggbb",
   "default": "#151515"
  },
  "fit": {
   "type": "enum",
   "values": [
    "cover",
    "contain"
   ],
   "default": "cover"
  }
 }
}